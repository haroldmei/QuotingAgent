# ============================================================
# QuotingAgent — Environment Variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to version control.
# ============================================================

# ------------------------------------------------------------
# Supabase (auth, database, realtime)
# Get these from: https://app.supabase.com → Project Settings → API
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Postgres direct connection (used by Prisma / db migrations)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# ------------------------------------------------------------
# Upstash Redis (rate limiting, NFR-012)
# Get these from: https://console.upstash.com → Redis → REST API
# Leave blank in local dev — a no-op limiter is used automatically.
# REQUIRED in production.
# ------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ------------------------------------------------------------
# Anthropic (AI quote generation)
# Get from: https://console.anthropic.com → API Keys
# ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ------------------------------------------------------------
# Voyage AI (embeddings for rate-card similarity search)
# Get from: https://dash.voyageai.com
# ------------------------------------------------------------
VOYAGE_API_KEY=pa-your-voyage-key-here

# ------------------------------------------------------------
# Twilio (SMS delivery)
# Get from: https://console.twilio.com
# ------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+61400000000

# ------------------------------------------------------------
# Resend (transactional email)
# Get from: https://resend.com → API Keys
# ------------------------------------------------------------
RESEND_API_KEY=re_your_resend_key
RESEND_FROM_EMAIL=noreply@yourdomain.com.au

# ------------------------------------------------------------
# Google Cloud Storage (photo storage, PDF export)
# Set up a service account with Storage Object Admin on the buckets.
# ------------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=quotingagent-photos-dev
GCS_PDF_BUCKET_NAME=quotingagent-pdfs-dev

# ------------------------------------------------------------
# Web Push (PWA notifications, VAPID)
# Generate with: npx web-push generate-vapid-keys
# ------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:dev@yourdomain.com.au

# ------------------------------------------------------------
# Security / signing secrets
# Generate with: openssl rand -hex 32
# ------------------------------------------------------------
QUOTE_SIGNING_HMAC_SECRET=your-32-byte-hex-secret
FSM_TOKEN_ENCRYPTION_KEY=your-32-byte-hex-encryption-key
DA_WEBHOOK_HMAC_SECRET=your-da-webhook-hmac-secret

# ------------------------------------------------------------
# FSM integrations (ServiceM8, Tradify)
# ------------------------------------------------------------
SERVICEM8_CLIENT_ID=your-servicem8-client-id
SERVICEM8_CLIENT_SECRET=your-servicem8-client-secret
TRADIFY_CLIENT_ID=your-tradify-client-id
TRADIFY_CLIENT_SECRET=your-tradify-client-secret

# DA (Deputy Assist) webhook source identifier
DA_CREW_ID=your-da-crew-id

# ------------------------------------------------------------
# External data providers
# ------------------------------------------------------------
SERVICE_NSW_API_KEY=your-service-nsw-api-key
BUNNINGS_POWERPASS_KEY=your-bunnings-powerpass-key

# ------------------------------------------------------------
# App URL (used for absolute URL generation)
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------
# Observability
# ------------------------------------------------------------
LOG_LEVEL=info
# Sentry DSN — optional, leave blank to disable
# NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
