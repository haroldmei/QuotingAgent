// QuotingAgent — Prisma Schema
// Stack contract: docs/00-tech-stack.md
// DB: postgres 16 via Supabase (supabase-pgbouncer)
// Auth: supabase-auth (user IDs are Supabase Auth UUIDs)
// Multi-tenancy: crew-as-tenant; RLS enforced at DB layer

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector", schema: "extensions")]
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum TradeType {
  roofer
  painter
  electrician
  plumber
  landscaper
}

enum UserRole {
  owner
  member
}

enum LeadSource {
  da
  manual
  inbound_sms
}

enum LeadStatus {
  new
  generating
  draft_ready
  sent
  delivered
  opened
  won
  lost
}

enum QuoteStatus {
  draft
  approved
  sent
  accepted
  declined
}

enum RateCardSource {
  live
  cached
  learned
}

enum SmsEventType {
  sent
  delivered
  failed
  opened
}

enum FsmProvider {
  servicem8
  tradify
}

enum FollowupStage {
  d3
  d7
}

enum LineItemKind {
  material
  labour
  other
}

// ---------------------------------------------------------------------------
// Crew (tenant unit — 1–10 users per crew)
// ---------------------------------------------------------------------------
model Crew {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessName          String    @map("business_name")
  tradeType             TradeType @map("trade_type")
  nswLicenceNumber      String    @map("nsw_licence_number")
  licenceVerified       Boolean   @default(false) @map("licence_verified")
  licenceVerifiedAt     DateTime? @map("licence_verified_at") @db.Timestamptz
  defaultLabourRateAud  Decimal   @map("default_labour_rate_aud") @db.Decimal(10, 2)
  abn                   String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  users          User[]
  leads          Lead[]
  fsmConnections FsmConnection[]
  jobCompletions JobCompletion[]

  @@map("crews")
}

// ---------------------------------------------------------------------------
// User (V1: owner only; V2: multi-member)
// id = Supabase Auth user UUID (not generated by Prisma)
// ---------------------------------------------------------------------------
model User {
  id        String   @id @db.Uuid // = auth.uid() from Supabase
  crewId    String   @map("crew_id") @db.Uuid
  phone     String   // E.164
  role      UserRole @default(owner)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  crew              Crew               @relation(fields: [crewId], references: [id], onDelete: Cascade)
  pushSubscriptions PushSubscription[]

  @@index([crewId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Lead
// ---------------------------------------------------------------------------
model Lead {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  crewId              String     @map("crew_id") @db.Uuid
  source              LeadSource
  daReference         String?    @map("da_reference")
  customerName        String     @map("customer_name")
  customerMobile      String?    @map("customer_mobile") // E.164
  customerEmail       String?    @map("customer_email")
  address             String?
  description         String?    @db.VarChar(280)
  status              LeadStatus @default(new)
  smsDisabledFollowup Boolean    @default(false) @map("sms_disabled_followup")
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  crew              Crew               @relation(fields: [crewId], references: [id], onDelete: Cascade)
  photos            Photo[]
  quotes            Quote[]
  followupSchedules FollowupSchedule[]
  jobCompletions    JobCompletion[]

  // DA dedup: unique per crew
  @@unique([crewId, daReference], name: "unique_crew_da_reference")
  @@index([crewId, createdAt(sort: Desc)], name: "idx_lead_crew_created")
  @@map("leads")
}

// ---------------------------------------------------------------------------
// Photo
// ---------------------------------------------------------------------------
model Photo {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId     String   @map("lead_id") @db.Uuid
  gcsPath    String   @map("gcs_path")
  exifData   Json?    @map("exif_data") // {lat, lng, timestamp, device}
  uploadedAt DateTime @default(now()) @map("uploaded_at") @db.Timestamptz

  // Relations
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("photos")
}

// ---------------------------------------------------------------------------
// Quote
// ---------------------------------------------------------------------------
model Quote {
  id                        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId                    String         @map("lead_id") @db.Uuid
  crewId                    String         @map("crew_id") @db.Uuid
  status                    QuoteStatus    @default(draft)
  subtotalAud               Decimal?       @map("subtotal_aud") @db.Decimal(12, 2)
  gstAud                    Decimal?       @map("gst_aud") @db.Decimal(12, 2)
  totalAud                  Decimal?       @map("total_aud") @db.Decimal(12, 2)
  licenceNumberSnapshot     String?        @map("licence_number_snapshot")
  licenceVerifiedSnapshot   Boolean?       @map("licence_verified_snapshot")
  statutoryWarrantyText     String?        @map("statutory_warranty_text") @db.Text
  pdfGcsPath                String?        @map("pdf_gcs_path")
  pdfSignedUrl              String?        @map("pdf_signed_url")
  pdfSignedUrlExpiresAt     DateTime?      @map("pdf_signed_url_expires_at") @db.Timestamptz
  rateCardSource            RateCardSource @default(live) @map("rate_card_source")
  createdAt                 DateTime       @default(now()) @map("created_at") @db.Timestamptz
  sentAt                    DateTime?      @map("sent_at") @db.Timestamptz

  // Relations
  lead        Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  lineItems   QuoteLineItem[]
  smsEvents   SmsEvent[]
  acceptance  QuoteAcceptance?
  aiUsage     QuoteAiUsage?

  // One active quote per lead
  @@index([leadId], name: "idx_quote_lead")
  @@map("quotes")
}

// ---------------------------------------------------------------------------
// QuoteLineItem
// ---------------------------------------------------------------------------
model QuoteLineItem {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quoteId        String       @map("quote_id") @db.Uuid
  description    String
  qty            Decimal      @db.Decimal(10, 3)
  unit           String       @db.VarChar(32)
  unitPriceAud   Decimal      @map("unit_price_aud") @db.Decimal(12, 2)
  confidenceScore Int          @map("confidence_score") @db.SmallInt // 0-100
  kind           LineItemKind @default(material)
  sortOrder      Int          @default(0) @map("sort_order")

  // Relations
  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_line_items")
}

// ---------------------------------------------------------------------------
// QuoteAcceptance (legal audit trail — 7-year retention)
// ---------------------------------------------------------------------------
model QuoteAcceptance {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quoteId             String   @unique @map("quote_id") @db.Uuid // idempotent: one per quote
  acceptedAt          DateTime @default(now()) @map("accepted_at") @db.Timestamptz
  ipAddress           String   @map("ip_address") // inet stored as text
  userAgent           String   @map("user_agent") @db.Text
  customerNameSnapshot String  @map("customer_name_snapshot")
  retentionUntil      DateTime @map("retention_until") @db.Date

  // Relations
  quote Quote @relation(fields: [quoteId], references: [id])

  @@index([retentionUntil])
  @@map("quote_acceptances")
}

// ---------------------------------------------------------------------------
// QuoteAiUsage (token cost tracking per quote)
// ---------------------------------------------------------------------------
model QuoteAiUsage {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quoteId        String   @unique @map("quote_id") @db.Uuid
  modelVision    String   @map("model_vision")
  modelExtraction String  @map("model_extraction")
  inputTokens    Int      @map("input_tokens")
  outputTokens   Int      @map("output_tokens")
  costAud        Decimal  @map("cost_aud") @db.Decimal(8, 4)
  costOverrun    Boolean  @default(false) @map("cost_overrun")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@map("quote_ai_usage")
}

// ---------------------------------------------------------------------------
// SmsEvent
// ---------------------------------------------------------------------------
model SmsEvent {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quoteId         String       @map("quote_id") @db.Uuid
  twilioMessageSid String?     @map("twilio_message_sid")
  eventType       SmsEventType @map("event_type")
  occurredAt      DateTime     @default(now()) @map("occurred_at") @db.Timestamptz

  // Relations
  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, occurredAt(sort: Desc)])
  @@map("sms_events")
}

// ---------------------------------------------------------------------------
// JobCompletion (rate-card learning feedback)
// ---------------------------------------------------------------------------
model JobCompletion {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId           String    @map("lead_id") @db.Uuid
  crewId           String    @map("crew_id") @db.Uuid
  quotedAmountAud  Decimal   @map("quoted_amount_aud") @db.Decimal(12, 2)
  invoicedAmountAud Decimal? @map("invoiced_amount_aud") @db.Decimal(12, 2)
  tradeType        TradeType @map("trade_type")
  completedAt      DateTime  @default(now()) @map("completed_at") @db.Timestamptz

  // Relations
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  crew Crew @relation(fields: [crewId], references: [id], onDelete: Cascade)

  @@index([crewId, completedAt(sort: Desc)])
  @@map("job_completions")
}

// ---------------------------------------------------------------------------
// FsmConnection (ServiceM8 / Tradify OAuth tokens)
// ---------------------------------------------------------------------------
model FsmConnection {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  crewId             String      @map("crew_id") @db.Uuid
  provider           FsmProvider
  encryptedOauthToken String     @map("encrypted_oauth_token") @db.Text // AES-256-GCM
  expiresAt          DateTime?   @map("expires_at") @db.Timestamptz
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  crew Crew @relation(fields: [crewId], references: [id], onDelete: Cascade)

  @@unique([crewId, provider])
  @@map("fsm_connections")
}

// ---------------------------------------------------------------------------
// FollowupSchedule (D+3, D+7 auto-SMS)
// ---------------------------------------------------------------------------
model FollowupSchedule {
  id     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId String        @map("lead_id") @db.Uuid
  stage  FollowupStage
  fireAt DateTime      @map("fire_at") @db.Timestamptz
  fired  Boolean       @default(false)

  // Relations
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([fireAt, fired])
  @@map("followup_schedules")
}

// ---------------------------------------------------------------------------
// PushSubscription (Web Push VAPID)
// ---------------------------------------------------------------------------
model PushSubscription {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @db.Text
  p256dh    String
  authKey   String   @map("auth_key")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@map("push_subscriptions")
}

// ---------------------------------------------------------------------------
// AiCall (per-call AI ledger — finer-grained than quote_ai_usage)
// ai_heavy: cost_tracking=required; observability.token_metrics=required
// One row per Anthropic SDK call (vision pass, extraction pass, embedding,
// fallback retries). Roll up by quote_id for per-quote totals; by crew_id +
// created_at for rolling-mean Sentry alert (NFR-005).
// ---------------------------------------------------------------------------
model AiCall {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String?  @map("user_id") @db.Uuid
  crewId             String?  @map("crew_id") @db.Uuid
  quoteId            String?  @map("quote_id") @db.Uuid
  route              String   @db.VarChar(64)
  promptVersion      String   @map("prompt_version") @db.VarChar(64)
  model              String   @db.VarChar(64)
  inputTokens        Int      @default(0) @map("input_tokens")
  cachedInputTokens  Int      @default(0) @map("cached_input_tokens")
  outputTokens       Int      @default(0) @map("output_tokens")
  latencyMs          Int      @default(0) @map("latency_ms")
  costAud            Decimal  @default(0) @map("cost_aud") @db.Decimal(10, 6)
  isError            Boolean  @default(false) @map("is_error")
  fallbackUsed       Boolean  @default(false) @map("fallback_used")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([quoteId], name: "idx_ai_calls_quote_id")
  @@index([crewId, createdAt(sort: Desc)], name: "idx_ai_calls_crew_created")
  @@index([route, createdAt(sort: Desc)], name: "idx_ai_calls_route_created")
  @@index([model, createdAt(sort: Desc)], name: "idx_ai_calls_model_created")
  @@map("ai_calls")
}

// ---------------------------------------------------------------------------
// RateCardItem (Bunnings / Reece pricing cache)
// ---------------------------------------------------------------------------
model RateCardItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplier    String   @db.VarChar(64)
  sku         String   @db.VarChar(128)
  description String
  priceAud    Decimal  @map("price_aud") @db.Decimal(10, 2)
  fetchedAt   DateTime @map("fetched_at") @db.Timestamptz
  stale       Boolean  @default(false)

  // Relations
  embedding RateCardEmbedding?

  @@unique([supplier, sku])
  @@index([stale, fetchedAt])
  @@map("rate_card_items")
}

// ---------------------------------------------------------------------------
// RateCardEmbedding (pgvector — 1536-dim for Voyage/OpenAI compatible)
// ---------------------------------------------------------------------------
// Note: Prisma does not natively support pgvector; this model stores the
// embedding as bytes and the actual vector column is managed via raw SQL
// migration. Prisma is used only for FK joins.
model RateCardEmbedding {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rateCardItemId String @unique @map("rate_card_item_id") @db.Uuid

  // The actual vector(1536) column is added via SQL migration (see supabase/migrations/)
  // Prisma does not yet support pgvector natively; use db.execute() for ANN queries.

  // Relations
  rateCardItem RateCardItem @relation(fields: [rateCardItemId], references: [id], onDelete: Cascade)

  @@map("rate_card_embeddings")
}
